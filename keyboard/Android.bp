aidl_interface {
    name: "vendor.xiaomi.hardware.keyboardnanoapp_aidl",
    owner: "xiaomi",
    vendor_available: true,
    srcs: ["interfaces/vendor/xiaomi/hardware/keyboardnanoapp_aidl/*.aidl"],
    local_include_dir: "interfaces",
    stability: "vintf",
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            sdk_version: "module_current",
        },
        ndk: {
            enabled: true,
        },
    },
}

cc_binary {
    name: "vendor.lineage.keyboard-service.liuqin",
    init_rc: ["vendor.lineage.keyboard-service.liuqin.rc"],
    vintf_fragments: ["vendor.lineage.keyboard-service.liuqin.xml"],
    relative_install_path: "hw",
    proprietary: true,
    srcs: [
        "KeyboardNanoapp.cpp",
        "NanoappDevice.cpp",
        "Protocol.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "vendor.xiaomi.hardware.keyboardnanoapp_aidl-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_binary {
    name: "vendor.lineage.keyboard-client.liuqin",
    relative_install_path: "hw",
    proprietary: true,
    srcs: [
        "Protocol.cpp",
        "keyboard_client.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "vendor.xiaomi.hardware.keyboardnanoapp_aidl-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
