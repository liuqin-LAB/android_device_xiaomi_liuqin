android_app {
    name: "LiuqinParts",
    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    privapp_allowlist: "privapp-permissions-org.lineageos.liuqinparts.xml",
    libs: ["framework-bluetooth.stubs.module_lib"],
    static_libs: [
        "androidx.preference_preference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "vendor.xiaomi.hardware.keyboardnanoapp_aidl-V1-java",
    ],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
